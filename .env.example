# =====================================================================
# Whybi AI – biến môi trường. Sao chép thành .env rồi điền giá trị thật.
#   cp .env.example .env
# KHÔNG commit .env (quy tắc Git mục 8.3 của kế hoạch phân công).
# =====================================================================

# --- Chung ---
APP_ENV=dev                      # dev | demo | prod
APP_NAME="Whybi AI"
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://localhost
LOG_LEVEL=INFO
LOG_JSON=true

# --- Chế độ AI (mục 3.3 kế hoạch) ---
LLM_MODE=fake                    # fake = Adapter trả JSON mẫu theo schema; real = gọi nhà cung cấp
DEMO_MODE=0                      # 1 = dùng cây và câu hỏi lưu sẵn cho kịch bản demo (thẻ C1-13)

# --- LLM (FR-AD-05, NFR-14) ---
LLM_PROVIDER=gemini              # gemini | openai_compat
LLM_MODEL=gemini-2.5-flash
LLM_FALLBACK_PROVIDER=openai_compat
LLM_FALLBACK_MODEL=
LLM_GUARD_MODEL=gemini-2.5-flash-lite   # Guard dùng model nhỏ hơn (C1-06)
GEMINI_API_KEY=
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
LLM_SESSION_TOKEN_BUDGET=20000   # NFR-13
EMBEDDING_DIM=768                # document_chunks.embedding vector(768)

# --- Giọng nói (mục 6.4) ---
STT_PROVIDER=cloud               # cloud | whisper
STT_WHISPER_URL=http://stt:9100
STT_MIN_CONFIDENCE=0.80
TTS_PROVIDER=cloud
AUDIO_RETENTION_DAYS=30          # NFR-09

# --- Xác thực (NFR-07) ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
ALLOW_DEV_TOKENS=true            # TẠM tới C2-07: Bearer dev-lecturer|dev-student|dev-admin; chỉ khi APP_ENV=dev, DEMO_MODE=0

# --- PostgreSQL 16 + pgvector ---
POSTGRES_USER=whybi
POSTGRES_PASSWORD=whybi
POSTGRES_DB=whybi
DATABASE_URL=postgresql+psycopg://whybi:whybi@postgres:5432/whybi

# --- Redis 7 (broker, pub/sub, cache) ---
REDIS_URL=redis://redis:6379/0

# --- MinIO (giáo trình, ghi âm) ---
MINIO_ROOT_USER=whybi
MINIO_ROOT_PASSWORD=whybi-minio-secret
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=whybi
S3_SECRET_KEY=whybi-minio-secret
S3_BUCKET=whybi
MAX_SYLLABUS_MB=20               # FR-SK-02

# --- Email (FR-AD-08) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=whybi@example.com
