# =====================================================================
# Whybi AI – biến môi trường. Sao chép thành .env rồi điền giá trị thật.
#   cp .env.example .env
# KHÔNG commit .env (quy tắc Git mục 8.3 của kế hoạch phân công).
# =====================================================================

# --- Chung ---
APP_ENV=dev                      # dev | demo | prod
APP_NAME="Whybi AI"
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://localhost
LOG_LEVEL=INFO
LOG_JSON=true

# --- Chế độ AI (mục 3.3 kế hoạch) ---
LLM_MODE=fake                    # fake = Adapter trả JSON mẫu theo schema; real = gọi nhà cung cấp
DEMO_MODE=0                      # 1 = dùng cây và câu hỏi lưu sẵn cho kịch bản demo (thẻ C1-13)

# --- LLM (FR-AD-05, NFR-14) ---
LLM_PROVIDER=openai_compat        # gemini | openai_compat
LLM_MODEL=gpt-4o-mini
LLM_FALLBACK_PROVIDER=gemini
LLM_FALLBACK_MODEL=
LLM_GUARD_MODEL=gpt-4o-mini            # Guard (C1-06) dùng model nhỏ
GEMINI_API_KEY=
OPENAI_COMPAT_BASE_URL=https://api.openai.com/v1
OPENAI_COMPAT_API_KEY=
LLM_SESSION_TOKEN_BUDGET=20000   # NFR-13
LLM_EMBEDDING_MODEL=text-embedding-3-small   # OpenAI; app gửi dimensions=EMBEDDING_DIM
EMBEDDING_DIM=768                # document_chunks.embedding vector(768)

# --- Giọng nói (mục 6.4) ---
STT_PROVIDER=cloud               # cloud | whisper
STT_WHISPER_URL=http://stt:8000
STT_MIN_CONFIDENCE=0.80
TTS_PROVIDER=cloud
AUDIO_RETENTION_DAYS=30          # NFR-09

# --- Xác thực (NFR-07) ---
JWT_SECRET=change-me-to-a-long-random-string   # demo / prod: BẮT BUỘC đổi, ≥ 32 ký tự ngẫu nhiên (api từ chối khóa mẫu)
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
ALLOW_DEV_TOKENS=true            # TẠM tới C2-07: Bearer dev-lecturer|dev-student|dev-admin; chỉ khi APP_ENV=dev, DEMO_MODE=0

# --- PostgreSQL 16 + pgvector ---
POSTGRES_USER=whybi
POSTGRES_PASSWORD=whybi
POSTGRES_DB=whybi
DATABASE_URL=postgresql+psycopg://whybi:whybi@postgres:5432/whybi

# --- Redis 7 (broker, pub/sub, cache) ---
REDIS_URL=redis://redis:6379/0

# --- Cổng host (đổi khi máy đã bận cổng; trong mạng compose các dịch vụ luôn dùng cổng container)
# NGINX_PORT=80
# API_PORT=8000
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# MINIO_PORT=9000
# MINIO_CONSOLE_PORT=9001
# STT_PORT=9100

# --- MinIO (giáo trình, ghi âm) ---
MINIO_ROOT_USER=whybi
MINIO_ROOT_PASSWORD=whybi-minio-secret
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=whybi
S3_SECRET_KEY=whybi-minio-secret
S3_BUCKET=whybi
MAX_SYLLABUS_MB=20               # FR-SK-02
TOC_GATE_ENABLED=true            # giáo trình lớn: dừng, AI cảnh báo từ mục lục, chờ GV chọn chương rồi mới dựng cây (false = chỉ cảnh báo)
TOC_WARN_NODES=60                # ước số nút cây ≥ ngưỡng này thì cảnh báo / dừng
TOC_MAX_NODES=150                # ≥ ngưỡng này: mức "rất lớn"

# --- Email (FR-AD-08) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=whybi@example.com
